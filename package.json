{
  "name": "polish",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @polish/web",
    "dev:web": "npm run dev --workspace @polish/web",
    "dev:desktop": "npm run dev --workspace @polish/desktop",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > apps/web/lib/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.113.0",
    "typescript": "^5"
  }
}
