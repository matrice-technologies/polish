# The Polish web app this build signs in through by default. Unset, builds use
# production (https://polish.matricetechnologies.com). Set it for local
# development in .env.development (dev mode only, so installers built on the
# same machine still point at production). It can also be changed in the app
# under Account → Server.
MAIN_VITE_WEB_URL=http://localhost:3000
