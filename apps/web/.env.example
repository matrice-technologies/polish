# Copy to .env.local for development.

# Supabase project this app talks to. Anon key is public; the service role key
# bypasses RLS and is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this app. Used for magic-link and invitation URLs.
#
# Leave unset in development: URLs are then built from the incoming request
# host, so they stay correct whatever port Next binds. Set it in production.
# NEXT_PUBLIC_SITE_URL=https://app.example.com

# Brevo HTTP API v3 key, for mail this app sends itself (workspace invitations).
# Auth magic links go out through GoTrue's own SMTP config, not this key.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
